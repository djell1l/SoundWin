<Page
    x:Class="SoundWin.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models"
    xmlns:controls="using:SoundWin.App.Controls">

    <ScrollViewer Padding="32,20,32,48">
        <StackPanel HorizontalAlignment="Stretch" Spacing="24">
            <!-- NOT LOGGED IN STATE -->
            <Grid
                x:Name="LoginPromptCard"
                Padding="32"
                CornerRadius="12"
                Background="#18181E"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8D7;" FontSize="48" Foreground="{StaticResource SoundCloudOrangeBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Connectez-vous à SoundCloud" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Synchronisez vos coups de cœur (Likes), vos playlists, vos abonnements et votre historique SoundCloud en temps réel dans une interface 100% native WinUI 3."
                        FontSize="14"
                        Opacity="0.75"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Height="44"
                        Padding="24,0"
                        Background="{StaticResource SoundCloudOrangeBrush}"
                        Foreground="White"
                        CornerRadius="22"
                        Click="OnLoginButtonClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock Text="Connexion sécurisée" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- SOUNDCLOUD LIBRARY TOP TABS BAR (Tout, Favoris, Playlists, Albums, Stations, Abonné(e), Historique, Suggestions) -->
            <Grid
                x:Name="LibraryHeaderBar"
                Visibility="Collapsed"
                ColumnDefinitions="*,Auto"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8">
                <SelectorBar x:Name="LibrarySelectorBar" Grid.Column="0" SelectionChanged="OnLibraryTabSelectionChanged">
                    <SelectorBarItem Text="Tout" Tag="all" IsSelected="True" />
                    <SelectorBarItem Text="Favoris" Tag="likes" />
                    <SelectorBarItem Text="Playlists" Tag="playlists" />
                    <SelectorBarItem Text="Albums" Tag="albums" />
                    <SelectorBarItem Text="Stations" Tag="stations" />
                    <SelectorBarItem Text="Abonné(e)" Tag="following" />
                    <SelectorBarItem Text="Historique" Tag="history" />
                    <SelectorBarItem Text="Suggestions" Tag="suggestions" />
                </SelectorBar>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button
                        Click="OnRefreshLibraryClick"
                        Background="#18FFFFFF"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Actualiser" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="{StaticResource SoundCloudOrangeBrush}"
                        Foreground="White"
                        CornerRadius="6"
                        Padding="14,6"
                        Click="OnCreatePlaylistClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Nouvelle Playlist" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="LikesLoadingProgress" IsIndeterminate="True" Visibility="Collapsed" />

            <!-- ==========================================
                 1. MY PLAYLISTS SECTION
                 ========================================== -->
            <StackPanel x:Name="PlaylistsSection" Visibility="Collapsed" Spacing="16">
                <TextBlock Text="Playlists" FontSize="20" FontWeight="Bold" />

                <GridView
                    x:Name="UserPlaylistsGridView"
                    ItemsSource="{x:Bind ViewModel.UserPlaylists, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnPlaylistItemClicked">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <Border
                                Width="176"
                                Padding="12"
                                Margin="0,0,14,14"
                                CornerRadius="10"
                                Background="#16161C"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1">
                                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                    <Border Width="150" Height="150" CornerRadius="8" Background="#22222A" HorizontalAlignment="Center">
                                        <Image Source="{x:Bind DisplayArtworkUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind TrackCount}" FontSize="11" Opacity="0.6" />
                                        <TextBlock Text="titres" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- ==========================================
                 2. LIKES / FAVORIS SECTION
                 ========================================== -->
            <StackPanel x:Name="LikesSection" Visibility="Collapsed" Spacing="16">
                <TextBlock Text="Ecoutez les titres que vous avez aimés :" FontSize="20" FontWeight="Bold" />

                <ListView
                    x:Name="LikesListView"
                    ItemsSource="{x:Bind ViewModel.LikedTracks, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <controls:TrackRowControl Track="{x:Bind}" PlayRequested="OnPlayTrackRequested" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- ==========================================
                 3. ABONNÉ(E) SECTION (Matches Screenshot media_1792956945176)
                 ========================================== -->
            <StackPanel x:Name="FollowingSection" Visibility="Collapsed" Spacing="20">
                <Grid ColumnDefinitions="*,260">
                    <TextBlock
                        Grid.Column="0"
                        Text="Ecoutez ce que les personnes que vous suivez ont posté :"
                        FontSize="18"
                        FontWeight="Bold"
                        VerticalAlignment="Center" />
                    <TextBox
                        Grid.Column="1"
                        PlaceholderText="Filtre"
                        Text="{x:Bind ViewModel.FollowingFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center" />
                </Grid>

                <GridView
                    ItemsSource="{x:Bind ViewModel.FollowedArtists, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnArtistCardItemClicked">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <StackPanel Width="184" Padding="10" Margin="0,0,16,20" Spacing="10" HorizontalAlignment="Center">
                                <PersonPicture
                                    Width="156"
                                    Height="156"
                                    HorizontalAlignment="Center"
                                    ProfilePicture="{x:Bind HighResAvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                    DisplayName="{x:Bind Username, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind Username, Mode=OneWay}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Opacity="0.65">
                                    <FontIcon Glyph="&#xE716;" FontSize="11" />
                                    <TextBlock Text="{x:Bind FollowersCount, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Text="abonnés" FontSize="12" />
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Center"
                                    Padding="14,5"
                                    CornerRadius="4"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"
                                    Click="OnToggleFollowArtistCardClicked" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- ==========================================
                 4. HISTORIQUE SECTION
                 ========================================== -->
            <StackPanel x:Name="HistorySection" Visibility="Collapsed" Spacing="16">
                <TextBlock Text="Écoutés récemment :" FontSize="20" FontWeight="Bold" />

                <ListView
                    ItemsSource="{x:Bind ViewModel.HistoryTracks, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <controls:TrackRowControl Track="{x:Bind}" PlayRequested="OnPlayTrackRequested" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- ==========================================
                 5. SUGGESTIONS SECTION (Matches Screenshot media_1792956959922)
                 ========================================== -->
            <StackPanel x:Name="SuggestionsSection" Visibility="Collapsed" Spacing="20">
                <TextBlock
                    Text="Suggestions de comptes à suivre, basées sur votre historique d'écoute :"
                    FontSize="18"
                    FontWeight="Bold" />

                <GridView
                    ItemsSource="{x:Bind ViewModel.SuggestedArtists, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnArtistCardItemClicked">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <StackPanel Width="184" Padding="10" Margin="0,0,16,20" Spacing="10" HorizontalAlignment="Center">
                                <PersonPicture
                                    Width="156"
                                    Height="156"
                                    HorizontalAlignment="Center"
                                    ProfilePicture="{x:Bind HighResAvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                    DisplayName="{x:Bind Username, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind Username, Mode=OneWay}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Opacity="0.65">
                                    <FontIcon Glyph="&#xE716;" FontSize="11" />
                                    <TextBlock Text="{x:Bind FollowersCount, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Text="abonnés" FontSize="12" />
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Center"
                                    Background="White"
                                    Foreground="Black"
                                    Padding="16,5"
                                    CornerRadius="4"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"
                                    Click="OnToggleFollowArtistCardClicked" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
