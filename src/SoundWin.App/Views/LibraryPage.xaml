<Page
    x:Class="SoundWin.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models"
    xmlns:controls="using:SoundWin.App.Controls">

    <ScrollViewer Padding="28,24,28,40">
        <StackPanel Spacing="24">
            <!-- NOT LOGGED IN STATE -->
            <Grid
                x:Name="LoginPromptCard"
                Padding="32"
                CornerRadius="12"
                Background="#18181E"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="16" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8D7;" FontSize="48" Foreground="{StaticResource SoundCloudOrangeBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Connectez-vous à SoundCloud" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Accédez directement à l'ensemble de votre bibliothèque personnelle : titres likés, playlists sauvegardées et flux d'artistes."
                        FontSize="14"
                        Opacity="0.75"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Height="44"
                        Padding="24,0"
                        Background="{StaticResource SoundCloudOrangeBrush}"
                        Foreground="White"
                        CornerRadius="22"
                        Click="OnLoginButtonClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock Text="Connexion sécurisée" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- LOGGED IN USER PROFILE HEADER -->
            <Grid
                x:Name="UserProfileCard"
                Visibility="Collapsed"
                Padding="24"
                CornerRadius="12"
                Background="#18181E"
                ColumnDefinitions="Auto,*,Auto">

                <PersonPicture
                    x:Name="UserAvatar"
                    Width="64"
                    Height="64"
                    Margin="0,0,20,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="UsernameText" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Compte SoundCloud synchronisé" FontSize="12" Opacity="0.6" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OnLogoutClick"
                    Background="Transparent"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xF3B1;" FontSize="13" />
                        <TextBlock Text="Déconnexion" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- LIKES SECTION -->
            <StackPanel x:Name="LikesSection" Visibility="Collapsed" Spacing="16">
                <TextBlock Text="Titres Likés" FontSize="20" FontWeight="Bold" />
                <ProgressBar x:Name="LikesLoadingProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <ListView
                    x:Name="LikesListView"
                    ItemsSource="{x:Bind ViewModel.LikedTracks, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <controls:TrackRowControl Track="{x:Bind}" PlayRequested="OnPlayTrackRequested" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
