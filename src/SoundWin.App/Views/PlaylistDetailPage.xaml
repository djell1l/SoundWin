<Page
    x:Class="SoundWin.App.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models"
    xmlns:controls="using:SoundWin.App.Controls">

    <ScrollViewer Padding="32,24,32,48">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left" Spacing="24">
            <!-- Back Button -->
            <Button
                Background="Transparent"
                BorderThickness="0"
                Padding="8,6"
                CornerRadius="6"
                Click="OnBackClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Retour" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Playlist Header Card -->
            <Border
                Background="#18181E"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="28">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Cover Art -->
                    <Border
                        Grid.Column="0"
                        Width="168"
                        Height="168"
                        CornerRadius="12"
                        Margin="0,0,28,0"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1">
                        <Image x:Name="PlaylistCoverImage" Stretch="UniformToFill" />
                    </Border>

                    <!-- Metadata & Actions -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                        <Border Background="#25FF5500" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                            <TextBlock x:Name="PlaylistTypeBadge" Text="PLAYLIST / ALBUM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SoundCloudOrangeBrush}" />
                        </Border>

                        <TextBlock x:Name="PlaylistTitleText" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" />

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaylistAuthorText" FontSize="14" FontWeight="SemiBold" Opacity="0.85" />
                            <TextBlock Text="•" Opacity="0.5" />
                            <TextBlock x:Name="PlaylistCountText" FontSize="13" Opacity="0.65" />
                        </StackPanel>

                        <TextBlock
                            x:Name="PlaylistDescriptionText"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            MaxLines="3"
                            Visibility="Collapsed" />

                        <!-- Action Buttons Row -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button
                                Background="{StaticResource SoundCloudOrangeBrush}"
                                Foreground="White"
                                CornerRadius="20"
                                Height="40"
                                Padding="22,0"
                                Click="OnPlayAllClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Tout lire" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button
                                Background="#20FFFFFF"
                                BorderThickness="0"
                                CornerRadius="20"
                                Height="40"
                                Padding="18,0"
                                Click="OnShufflePlayClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                    <TextBlock Text="Lecture aléatoire" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="DeletePlaylistButton"
                                Visibility="Collapsed"
                                Background="#25FF3B30"
                                Foreground="#FF453A"
                                BorderThickness="0"
                                CornerRadius="20"
                                Height="40"
                                Padding="16,0"
                                Click="OnDeletePlaylistClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="Supprimer la playlist" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading Indicator -->
            <ProgressRing
                x:Name="TracksLoadingRing"
                IsActive="False"
                Visibility="Collapsed"
                Width="36"
                Height="36"
                HorizontalAlignment="Center" />

            <!-- Tracklist Header -->
            <StackPanel Spacing="12">
                <TextBlock Text="Titres de la sélection" FontSize="18" FontWeight="Bold" />

                <ListView
                    x:Name="TracksListView"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <controls:TrackRowControl Track="{x:Bind}" PlayRequested="OnTrackPlayRequested" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
