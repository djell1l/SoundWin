<Page
    x:Class="SoundWin.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models"
    xmlns:controls="using:SoundWin.App.Controls">

    <ScrollViewer x:Name="MainScrollViewer" Padding="28,20,28,48" VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*,290" ColumnSpacing="32" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ==========================================
                 LEFT COLUMN: MAIN DISCOVERY SHELVES (Albums & Tracks)
                 ========================================== -->
            <StackPanel Grid.Column="0" Spacing="28">
                <!-- Loading Indicator -->
                <ProgressRing
                    x:Name="LoadingRing"
                    IsActive="True"
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Center"
                    Margin="0,30,0,0" />

                <!-- Error Notification -->
                <InfoBar
                    x:Name="ErrorInfoBar"
                    IsOpen="False"
                    Severity="Error" />

                <!-- Shelves Container -->
                <ItemsControl x:Name="ShelvesContainer">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Shelf">
                            <StackPanel Margin="0,0,0,28" Spacing="14">
                                <!-- Shelf Title -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.6" Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, FallbackValue=Collapsed}" />
                                </StackPanel>

                                <!-- Horizontal Track Cards (When Shelf has Tracks — matches SoundCloud Home cards!) -->
                                <ScrollViewer
                                    Visibility="{x:Bind HasTracks, Converter={StaticResource BooleanVisibilityConverter}}"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    PointerWheelChanged="OnHorizontalScrollViewerPointerWheelChanged">
                                    <ItemsControl ItemsSource="{x:Bind Tracks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="16" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:Track">
                                                <Grid Width="156" Padding="0,0,0,4">
                                                    <Button
                                                        Width="156"
                                                        Padding="6"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="OnTrackCardClicked">
                                                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                                            <Border Width="144" Height="144" CornerRadius="6" Background="#1E1E26" HorizontalAlignment="Center">
                                                                <Image Source="{x:Bind HighResArtworkUrl}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                            <TextBlock Text="{x:Bind Artist}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Horizontal Playlists / Albums Cards (Wheel-safe!) -->
                                <ScrollViewer
                                    Visibility="{x:Bind HasPlaylists, Converter={StaticResource BooleanVisibilityConverter}}"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    PointerWheelChanged="OnHorizontalScrollViewerPointerWheelChanged">
                                    <ItemsControl ItemsSource="{x:Bind Playlists}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="16" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:Playlist">
                                                <Grid Width="156" Padding="0,0,0,4">
                                                    <!-- Main Card Button (Opens Playlist Detail View) -->
                                                    <Button
                                                        Width="156"
                                                        Padding="6"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="OnPlaylistCardClicked">
                                                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                                            <!-- Artwork -->
                                                            <Border Width="144" Height="144" CornerRadius="6" Background="#1E1E26" HorizontalAlignment="Center">
                                                                <Image Source="{x:Bind DisplayArtworkUrl}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <!-- Title & Author -->
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                            <TextBlock Text="{x:Bind Author}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Quick Play Button Overlay (Bottom-Right of Artwork) -->
                                                    <Button
                                                        Width="34"
                                                        Height="34"
                                                        CornerRadius="17"
                                                        Padding="0"
                                                        Background="{StaticResource SoundCloudOrangeBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,108,14,0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        ToolTipService.ToolTip="Lire immédiatement cette sélection"
                                                        Click="OnQuickPlayPlaylistClicked">
                                                        <SymbolIcon Symbol="Play" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ==========================================
                 RIGHT COLUMN: SOUNDCLOUD HOME SIDEBAR (Screenshot #4)
                 ========================================== -->
            <StackPanel Grid.Column="1" Spacing="28">

                <!-- 1. ARTISTES QUE VOUS DEVRIEZ SUIVRE -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="ARTISTES QUE VOUS DEVRIEZ SUIVRE" FontSize="11" FontWeight="Bold" Opacity="0.75" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="Actualiser la liste"
                            FontSize="11"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Opacity="0.6"
                            Click="OnRefreshSidebarClicked" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.SuggestedUsers, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:User">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <Button
                                        Grid.Column="0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnSuggestedArtistClicked">
                                        <PersonPicture
                                            Width="40"
                                            Height="40"
                                            ProfilePicture="{x:Bind HighResAvatarUrl}"
                                            DisplayName="{x:Bind Username}"
                                            Margin="0,0,10,0" />
                                    </Button>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Username}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon Glyph="&#xE716;" FontSize="10" Opacity="0.6" />
                                                <TextBlock Text="{x:Bind FollowersCount}" FontSize="11" Opacity="0.6" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="10" Opacity="0.6" />
                                                <TextBlock Text="{x:Bind TrackCount}" FontSize="11" Opacity="0.6" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Content="Suivre"
                                        Background="White"
                                        Foreground="Black"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        Padding="12,4"
                                        CornerRadius="4"
                                        Click="OnFollowSuggestedArtistClicked" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. MENTION J'AIME (LIKES) -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TotalLikesCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.75" />
                            <TextBlock Text="MENTIONS J'AIME" FontSize="11" FontWeight="Bold" Opacity="0.75" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="Tout afficher"
                            FontSize="11"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Opacity="0.6"
                            Click="OnViewAllLikesClicked" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.SidebarLikedTracks, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnTrackCardClicked">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4" Margin="0,0,10,0">
                                            <Image Source="{x:Bind HighResArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.55">
                                                <TextBlock Text="{x:Bind PlaybackCount}" FontSize="10" />
                                                <TextBlock Text="•" FontSize="10" />
                                                <TextBlock Text="{x:Bind LikesCount}" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 3. HISTORIQUE D'ÉCOUTE -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="HISTORIQUE D'ÉCOUTE" FontSize="11" FontWeight="Bold" Opacity="0.75" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.PlayHistoryTracks, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnTrackCardClicked">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4" Margin="0,0,10,0">
                                            <Image Source="{x:Bind HighResArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
