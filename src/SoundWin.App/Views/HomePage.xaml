<Page
    x:Class="SoundWin.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models"
    xmlns:controls="using:SoundWin.App.Controls">

    <ScrollViewer x:Name="MainScrollViewer" Padding="28,24,28,40" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="32">
            <!-- Header Banner -->
            <Grid Padding="24" CornerRadius="12" Background="#1E1E24" BorderBrush="#20FFFFFF" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="SoundWin" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Explorez les dernières tendances mondiales, titres populaires et playlists curatées directement depuis SoundCloud — sans aucune publicité."
                               FontSize="14" Opacity="0.75" />
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="True"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                Margin="0,40,0,0" />

            <!-- Error Notification -->
            <InfoBar
                x:Name="ErrorInfoBar"
                IsOpen="False"
                Severity="Error" />

            <!-- Shelves Container -->
            <ItemsControl x:Name="ShelvesContainer">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Shelf">
                        <StackPanel Margin="0,0,0,28" Spacing="14">
                            <!-- Shelf Title -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.6" Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>

                            <!-- Tracks List (Directly Selectable & Playable!) -->
                            <ItemsControl
                                ItemsSource="{x:Bind Tracks}"
                                Visibility="{x:Bind HasTracks, Converter={StaticResource BooleanVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Track">
                                        <controls:TrackRowControl Track="{x:Bind}" PlayRequested="OnTrackPlayRequested" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Playlists / Albums Horizontal List (Wheel-safe!) -->
                            <ScrollViewer
                                Visibility="{x:Bind HasPlaylists, Converter={StaticResource BooleanVisibilityConverter}}"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled"
                                PointerWheelChanged="OnHorizontalScrollViewerPointerWheelChanged">
                                <ItemsControl ItemsSource="{x:Bind Playlists}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Playlist">
                                            <Grid Width="164" Padding="0,0,0,4">
                                                <!-- Main Card Button (Opens Playlist Detail View) -->
                                                <Button
                                                    Width="164"
                                                    Padding="0"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    CornerRadius="10"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OnPlaylistCardClicked">
                                                    <StackPanel Spacing="6" Padding="8">
                                                        <!-- Artwork -->
                                                        <Grid Width="148" Height="148">
                                                            <Border CornerRadius="8" Background="#1E1E26">
                                                                <Image Source="{x:Bind DisplayArtworkUrl}" Stretch="UniformToFill" />
                                                            </Border>
                                                        </Grid>
                                                        <!-- Title & Author -->
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        <TextBlock Text="{x:Bind Author}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Quick Play Button Overlay (Bottom-Right of Artwork) -->
                                                <Button
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="18"
                                                    Padding="0"
                                                    Background="{StaticResource SoundCloudOrangeBrush}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,112,16,0"
                                                    ToolTipService.ToolTip="Lire immédiatement cette sélection"
                                                    Click="OnQuickPlayPlaylistClicked">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
