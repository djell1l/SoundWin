<Page
    x:Class="SoundWin.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models"
    xmlns:controls="using:SoundWin.App.Controls">

    <ScrollViewer Padding="28,24,28,40">
        <StackPanel Spacing="32">
            <!-- Header Banner -->
            <Grid Padding="24" CornerRadius="12" Background="#1E1E24">
                <StackPanel Spacing="8">
                    <TextBlock Text="SoundWin" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Explorez les dernières tendances mondiales et playlists curatées directement depuis SoundCloud."
                               FontSize="14" Opacity="0.75" />
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="True"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                Margin="0,40,0,0" />

            <!-- Error Notification -->
            <InfoBar
                x:Name="ErrorInfoBar"
                IsOpen="False"
                Severity="Error" />

            <!-- Shelves Container -->
            <ItemsControl x:Name="ShelvesContainer">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Shelf">
                        <StackPanel Margin="0,0,0,28" Spacing="12">
                            <!-- Shelf Title -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.6" Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>

                            <!-- Playlists Horizontal List -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                <ItemsControl ItemsSource="{x:Bind Playlists}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Playlist">
                                            <Button
                                                Width="160"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                CornerRadius="10"
                                                Click="OnPlaylistClicked">
                                                <StackPanel Spacing="8" Padding="8">
                                                    <!-- Artwork -->
                                                    <Grid Width="144" Height="144">
                                                        <Border CornerRadius="8">
                                                            <Image Source="{x:Bind DisplayArtworkUrl}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </Grid>
                                                    <!-- Title & Author -->
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    <TextBlock Text="{x:Bind Author}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
