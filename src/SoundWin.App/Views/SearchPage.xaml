<Page
    x:Class="SoundWin.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models"
    xmlns:controls="using:SoundWin.App.Controls">

    <Grid Padding="28,24,28,40" RowDefinitions="Auto,Auto,*">
        <!-- Search Input Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Rechercher des titres, artistes, albums ou podcasts sur SoundCloud..."
                FontSize="15"
                Height="42"
                QueryIcon="Find"
                TextChanged="OnSearchTextChanged"
                QuerySubmitted="OnSearchQuerySubmitted"
                SuggestionChosen="OnSuggestionChosen" />
            <Button
                Grid.Column="1"
                Margin="12,0,0,0"
                Height="42"
                Padding="16,0"
                Background="{StaticResource SoundCloudOrangeBrush}"
                Foreground="White"
                Click="OnSearchButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                    <TextBlock Text="Rechercher" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Progress Ring -->
        <ProgressBar
            x:Name="SearchProgress"
            Grid.Row="1"
            IsIndeterminate="True"
            Visibility="Collapsed"
            Margin="0,0,0,16" />

        <!-- Results Pivot -->
        <Pivot x:Name="ResultsPivot" Grid.Row="2">
            <!-- Tracks -->
            <PivotItem Header="Titres">
                <ListView
                    x:Name="TracksListView"
                    ItemsSource="{x:Bind ViewModel.TrackResults, Mode=OneWay}"
                    SelectionMode="None"
                    ItemClick="OnTrackItemClick"
                    IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <controls:TrackRowControl Track="{x:Bind}" PlayRequested="OnPlayTrackRequested" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Playlists -->
            <PivotItem Header="Playlists">
                <GridView
                    x:Name="PlaylistsGridView"
                    ItemsSource="{x:Bind ViewModel.PlaylistResults, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnPlaylistItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <StackPanel Width="150" Margin="8" Spacing="6">
                                <Grid Width="150" Height="150">
                                    <Border CornerRadius="8">
                                        <Image Source="{x:Bind DisplayArtworkUrl}" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind Author}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <!-- Artists -->
            <PivotItem Header="Artistes">
                <ListView
                    x:Name="UsersListView"
                    ItemsSource="{x:Bind ViewModel.UserResults, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto">
                                <PersonPicture
                                    ProfilePicture="{x:Bind HighResAvatarUrl}"
                                    DisplayName="{x:Bind Username}"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{x:Bind City}" FontSize="12" Opacity="0.6" Visibility="{x:Bind City, Converter={StaticResource StringVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind FollowersCount}" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
