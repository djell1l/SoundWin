<Page
    x:Class="SoundWin.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SoundWin.App.Controls"
    xmlns:models="using:SoundWin.Core.Models">

    <ScrollViewer Padding="28,20,28,48">
        <StackPanel HorizontalAlignment="Stretch" Spacing="20">

            <!-- ==========================================
                 1. SOUNDCLOUD HERO HEADER BANNER (240px)
                 ========================================== -->
            <Border
                Height="230"
                CornerRadius="6"
                Background="#7A7A80"
                BorderBrush="#25FFFFFF"
                BorderThickness="1">
                <Grid>
                    <!-- Optional Banner Background Image -->
                    <Image
                        x:Name="BannerHeaderImage"
                        Source="{x:Bind Vm.User.HighResBannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                        Visibility="{x:Bind Vm.User.HasBannerImage, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        Stretch="UniformToFill" />

                    <!-- Subtle Dark Gradient Overlay for Contrast -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#20000000" Offset="0" />
                                <GradientStop Color="#55000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Left: Circular Avatar (172x172) + Black Box Badges -->
                    <Grid Padding="28,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <!-- Circular Profile Picture with Hover Camera Update Button -->
                        <Grid
                            Grid.Column="0"
                            Width="172"
                            Height="172"
                            Margin="0,0,28,0"
                            PointerEntered="OnAvatarAreaPointerEntered"
                            PointerExited="OnAvatarAreaPointerExited">
                            <Grid Width="172" Height="172">
                                <Ellipse Fill="#282832" />
                                <FontIcon Glyph="&#xE77B;" FontSize="64" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse x:Name="ProfileAvatarEllipse">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{x:Bind Vm.User.HighResAvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <!-- "Mettre à jour l'image" button on Avatar -->
                            <Button
                                x:Name="UpdateAvatarOverlayBtn"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,14"
                                Background="#D9121214"
                                Foreground="White"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,5"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Click="OnUploadAvatarClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE722;" FontSize="12" />
                                    <TextBlock Text="Mettre à jour l'image" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- SoundCloud Classic Black Label Boxes for Username & FullName -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" HorizontalAlignment="Left">
                            <Border Background="#E60E0E10" Padding="12,6" CornerRadius="2" HorizontalAlignment="Left">
                                <TextBlock
                                    Text="{x:Bind Vm.User.Username, Mode=OneWay, FallbackValue='Utilisateur SoundCloud'}"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </Border>

                            <Border
                                Background="#D90E0E10"
                                Padding="10,4"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind Vm.User.HasFullName, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}">
                                <TextBlock
                                    Text="{x:Bind Vm.User.DisplayFullName, Mode=OneWay}"
                                    FontSize="14"
                                    Foreground="#E0E0E0" />
                            </Border>

                            <Border
                                Background="#CC0E0E10"
                                Padding="10,3"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind Vm.User.City, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                                <TextBlock
                                    Text="{x:Bind Vm.User.City, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="#BDBDBD" />
                            </Border>
                        </StackPanel>

                        <!-- Top-Right Button: "Uploadez une image d'en-tête" -->
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="0,-16,0,0"
                            Background="#D9121214"
                            Foreground="White"
                            BorderBrush="#35FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14,7"
                            Visibility="{x:Bind Vm.IsOwnProfile, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                            Click="OnUploadHeaderBannerClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE722;" FontSize="12" />
                                <TextBlock Text="Uploadez une image d'en-tête" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==========================================
                 2. NAVIGATION BAR + ACTION BUTTONS (Partager / Modifier)
                 ========================================== -->
            <Grid ColumnDefinitions="*,Auto" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                <SelectorBar x:Name="ProfileSelectorBar" Grid.Column="0" SelectionChanged="OnSelectorBarSelectionChanged">
                    <SelectorBarItem Text="Tout" Tag="all" IsSelected="True" />
                    <SelectorBarItem Text="Titres populaires" Tag="popular" />
                    <SelectorBarItem Text="Titres" Tag="tracks" />
                    <SelectorBarItem Text="Playlists" Tag="playlists" />
                    <SelectorBarItem Text="Reposts" Tag="reposts" />
                    <SelectorBarItem Text="Mentions J'aime" Tag="likes" />
                </SelectorBar>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- S'abonner / Abonné(e) Button (For other artists' profiles) -->
                    <Button
                        Background="{StaticResource SoundCloudOrangeBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="16,8"
                        Visibility="{x:Bind Vm.IsOwnProfile, Mode=OneWay, Converter={StaticResource InvertedBooleanVisibilityConverter}}"
                        Click="OnToggleFollowProfileClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="AddFriend" />
                            <TextBlock Text="{x:Bind Vm.User.FollowButtonText, Mode=OneWay, FallbackValue='Suivre'}" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button
                        Background="#20FFFFFF"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Click="OnShareProfileClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Share" />
                            <TextBlock Text="Partager" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button
                        Background="#20FFFFFF"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Visibility="{x:Bind Vm.IsOwnProfile, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        Click="OnEditProfileModalClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Edit" />
                            <TextBlock Text="Modifier" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status / Notification Bar -->
            <InfoBar
                x:Name="ProfileStatusInfoBar"
                IsOpen="False"
                IsClosable="True" />

            <!-- ==========================================
                 3. TWO-COLUMN SOUNDCLOUD BODY (Main Feed + Right Sidebar)
                 ========================================== -->
            <Grid ColumnDefinitions="*,300" ColumnSpacing="32">

                <!-- LEFT COLUMN: Active Tab Content -->
                <StackPanel Grid.Column="0" Spacing="20">

                    <!-- Pinned Spotlight Banner (Shown on 'Tout' tab) -->
                    <Border
                        x:Name="PinnedTracksSection"
                        Background="#141418"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Titres épinglés" FontSize="18" FontWeight="Bold" />
                                <TextBlock
                                    Text="Mettez en avant vos meilleurs titres et playlists : classez-les dans les Titres épinglés pour que vos auditeurs les voient en premier lorsqu'ils consultent votre profil."
                                    FontSize="12"
                                    Opacity="0.65"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="#20FFFFFF"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="12,6"
                                FontSize="12"
                                Content="Modifier les Titres épinglés"
                                Visibility="{x:Bind Vm.IsOwnProfile, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Section Header Title -->
                    <TextBlock x:Name="ActiveSectionTitle" Text="Récent" FontSize="18" FontWeight="Bold" />

                    <!-- Tracks List View (Used for Tout, Titres populaires, Titres, Reposts, Likes) -->
                    <ListView
                        x:Name="MainTracksListView"
                        ItemsSource="{x:Bind Vm.AllRecentTracks, Mode=OneWay}"
                        SelectionMode="None"
                        IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <controls:TrackRowControl Track="{x:Bind}" PlayRequested="OnTrackPlayRequested" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Playlists Detailed View (Used when 'Playlists' tab is selected, matching screenshot #2!) -->
                    <ItemsControl
                        x:Name="PlaylistsDetailedList"
                        Visibility="Collapsed"
                        ItemsSource="{x:Bind Vm.UserPlaylists, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <Border
                                    Background="#15151B"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20">
                                    <Grid ColumnDefinitions="160,*" ColumnSpacing="20">
                                        <!-- Left: Playlist Artwork -->
                                        <Button
                                            Grid.Column="0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Top"
                                            Click="OnOpenPlaylistDetailClicked">
                                            <Border Width="160" Height="160" CornerRadius="8" Background="#22222A">
                                                <Image Source="{x:Bind DisplayArtworkUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Border>
                                        </Button>

                                        <!-- Right: Play Button + Title + Embedded Track Rows + Action Bar -->
                                        <StackPanel Grid.Column="1" Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Button
                                                    Width="42"
                                                    Height="42"
                                                    CornerRadius="21"
                                                    Padding="0"
                                                    Background="White"
                                                    Foreground="Black"
                                                    Click="OnPlayPlaylistDirectClicked">
                                                    <FontIcon Glyph="&#xE768;" FontSize="16" Margin="2,0,0,0" />
                                                </Button>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Author}" FontSize="12" Opacity="0.65" />
                                                    <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="Bold" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Preview of Tracks inside Playlist -->
                                            <ItemsControl ItemsSource="{x:Bind Tracks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Track">
                                                        <controls:TrackRowControl Track="{x:Bind}" PlayRequested="OnTrackPlayRequested" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Bottom Bar: "Afficher X titres" + Action Buttons -->
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                <Button
                                                    Background="#20FFFFFF"
                                                    BorderThickness="0"
                                                    CornerRadius="4"
                                                    Padding="12,6"
                                                    Click="OnOpenPlaylistDetailClicked">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                                                        <TextBlock Text="Ouvrir la playlist complète" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- RIGHT SIDEBAR: Stats, Bio, Links, Likes Preview, Followings Preview -->
                <StackPanel Grid.Column="1" Spacing="24">
                    <!-- Stats Row: Abonnés | Abonnements | Titres -->
                    <Grid ColumnDefinitions="*,*,*" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Abonnés" FontSize="12" Opacity="0.6" />
                            <TextBlock Text="{x:Bind Vm.User.FollowersCount, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" BorderBrush="#20FFFFFF" BorderThickness="1,0,1,0" Padding="12,0">
                            <TextBlock Text="Abonnements" FontSize="12" Opacity="0.6" />
                            <TextBlock Text="{x:Bind Vm.User.FollowingsCount, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" Padding="12,0,0,0">
                            <TextBlock Text="Titres" FontSize="12" Opacity="0.6" />
                            <TextBlock Text="{x:Bind Vm.User.TrackCount, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <!-- Bio / Description -->
                    <TextBlock
                        Text="{x:Bind Vm.User.Description, Mode=OneWay}"
                        FontSize="13"
                        Opacity="0.85"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Vm.User.Description, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />

                    <!-- Web Profile Links -->
                    <ItemsControl ItemsSource="{x:Bind Vm.WebLinks, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WebProfileLink">
                                <HyperlinkButton Content="{x:Bind Title}" NavigateUri="{x:Bind Url}" Padding="0" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Mentions J'aime Preview Section -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB52;" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{x:Bind Vm.User.LikesCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Opacity="0.8" />
                                <TextBlock Text="MENTIONS J'AIME" FontSize="12" FontWeight="Bold" Opacity="0.8" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="Tout afficher"
                                FontSize="11"
                                Padding="6,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Opacity="0.65"
                                Click="OnShowAllLikesClicked" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind Vm.SidebarLikedTracks, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Track">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Click="OnSidebarTrackClicked">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4" Margin="0,0,10,0">
                                                <Image Source="{x:Bind HighResArtworkUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Abonnements Preview Section -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE716;" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{x:Bind Vm.User.FollowingsCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Opacity="0.8" />
                                <TextBlock Text="ABONNEMENTS" FontSize="12" FontWeight="Bold" Opacity="0.8" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind Vm.Followings, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:User">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Click="OnFollowingUserClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0">
                                                <Ellipse Fill="#2B2D31" />
                                                <FontIcon Glyph="&#xE77B;" FontSize="18" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind HighResAvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Username}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind FollowersCount}" FontSize="11" Opacity="0.6" />
                                                    <TextBlock Text="abonnés" FontSize="11" Opacity="0.6" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
