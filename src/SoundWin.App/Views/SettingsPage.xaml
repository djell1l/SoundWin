<Page
    x:Class="SoundWin.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,28,32,48">
        <StackPanel HorizontalAlignment="Stretch" Spacing="24">
            <!-- PAGE TITLE -->
            <StackPanel Spacing="6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="{StaticResource SoundCloudOrangeBrush}" />
                    <TextBlock Text="Paramètres" FontSize="26" FontWeight="Bold" />
                </StackPanel>
                <TextBlock
                    Text="Configurez vos intégrations, Discord Rich Presence, la fermeture dans la zone de notification et les mises à jour de SCwin."
                    FontSize="13"
                    Opacity="0.7" />
            </StackPanel>

            <!-- CARD 1: GENERAL & SYSTEM TRAY -->
            <Border
                Background="#18181E"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#20FFFFFF"
                            Margin="0,0,16,0">
                            <FontIcon Glyph="&#xE7F4;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Zone de notification (Systray)" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Comme Spotify ou Diswin : cliquer sur la croix (X) réduit SCwin dans la barre des tâches au lieu de quitter complètement l'application."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            IsOn="{x:Bind Vm.MinimizeToTrayOnClose, Mode=TwoWay}"
                            OnContent="Activé"
                            OffContent="Désactivé"
                            Margin="16,0,0,0" />
                    </Grid>

                    <MenuFlyoutSeparator Margin="0,16" />

                    <!-- Introduction au lancement -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border
                            Width="36"
                            Height="36"
                            CornerRadius="8"
                            Background="#1E1E26"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="{StaticResource SoundCloudOrangeBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Introduction audio et visuelle" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Joue le jingle SCwin avec l'animation du logo transparent à bords arrondis lors de l'ouverture de l'application."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            IsOn="{x:Bind Vm.EnableStartupIntro, Mode=TwoWay}"
                            OnContent="Activé"
                            OffContent="Désactivé"
                            Margin="16,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CARD 2: DISCORD RICH PRESENCE -->
            <Border
                Background="#18181E"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <StackPanel Spacing="20">
                    <!-- Top Row: Icon, Title, Status Badge, Master Toggle -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                        <!-- Discord Icon Circle -->
                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#255865F2"
                            Margin="0,0,16,0">
                            <FontIcon Glyph="&#xEBD3;" FontSize="20" Foreground="#5865F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Title & Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Discord Rich Presence" FontSize="16" FontWeight="SemiBold" />
                                <!-- Live Status Badge Pill -->
                                <Border
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Background="#20FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Fill="{x:Bind Vm.DiscordStatusBadgeColor, Mode=OneWay, Converter={StaticResource StatusColorBrushConverter}}" />
                                        <TextBlock
                                            Text="{x:Bind Vm.DiscordStatusBadgeText, Mode=OneWay}"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Foreground="{x:Bind Vm.DiscordStatusBadgeColor, Mode=OneWay, Converter={StaticResource StatusColorBrushConverter}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="Affiche le titre SoundCloud en cours d'écoute, l'artiste, la pochette et la progression sur votre profil Discord."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Master Toggle Switch -->
                        <ToggleSwitch
                            Grid.Column="3"
                            IsOn="{x:Bind Vm.IsDiscordRpcEnabled, Mode=TwoWay}"
                            OnContent="Activé"
                            OffContent="Désactivé"
                            Margin="16,0,0,0" />
                    </Grid>

                    <!-- Status Info Notification (when waiting or error) -->
                    <InfoBar
                        IsOpen="{x:Bind Vm.IsDiscordRpcEnabled, Mode=OneWay}"
                        Severity="{x:Bind Vm.IsDiscordConnected, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, FallbackValue='Informational'}"
                        IsClosable="False"
                        Message="{x:Bind Vm.DiscordStatusMessage, Mode=OneWay}"
                        Margin="0,0,0,4" />

                    <!-- Indented Detailed RPC Settings (visible only when RPC is enabled) -->
                    <StackPanel
                        Spacing="16"
                        Margin="60,0,0,0"
                        Visibility="{x:Bind Vm.IsDiscordRpcEnabled, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}">

                        <MenuFlyoutSeparator Margin="0,0,0,8" />

                        <!-- Cover Art Toggle -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Pochette d'album haute résolution" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="Transmet l'artwork original (500x500 px) de SoundCloud sur votre profil Discord." FontSize="11" Opacity="0.6" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind Vm.DiscordRpcShowCoverArt, Mode=TwoWay}"
                                OnContent="Oui"
                                OffContent="Non" />
                        </Grid>

                        <!-- Button Toggle -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Bouton d'écoute directe" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="Ajoute un bouton 'Écouter sur SoundCloud' permettant à vos amis d'ouvrir le morceau." FontSize="11" Opacity="0.6" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind Vm.DiscordRpcShowButtons, Mode=TwoWay}"
                                OnContent="Oui"
                                OffContent="Non" />
                        </Grid>

                        <!-- Show Paused Toggle -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Afficher lors de la mise en pause" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="Garde le morceau affiché avec la mention 'En pause' au lieu de masquer l'activité." FontSize="11" Opacity="0.6" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind Vm.DiscordRpcShowPaused, Mode=TwoWay}"
                                OnContent="Oui"
                                OffContent="Non" />
                        </Grid>

                        <!-- Discord Client ID (Developer / Custom) -->
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Identifiant d'application Discord (Client ID)" FontSize="13" FontWeight="Medium" />
                            <TextBlock
                                Text="Par défaut, SCwin utilise son application officielle. Vous pouvez spécifier votre propre Discord Application ID si souhaité."
                                FontSize="11"
                                Opacity="0.6" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBox
                                    Grid.Column="0"
                                    Text="{x:Bind Vm.DiscordRpcClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Ex: 463097721130188830"
                                    FontFamily="Consolas, Segoe UI"
                                    Height="36" />
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Height="36"
                                    Content="Rétablir par défaut"
                                    Command="{x:Bind Vm.ResetDiscordClientIdCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CARD 3: JAY ECOSYSTEM (DISWIN INTEGRATION) -->
            <Border
                Background="#18181E"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Border
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="#25FF5500"
                        Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE753;" FontSize="20" Foreground="{StaticResource SoundCloudOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Écosystème Jay (Passerelle Diswin)" FontSize="16" FontWeight="SemiBold" />
                            <Border Background="#25FF5500" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="ACTIF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SoundCloudOrangeBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Text="Permet à Diswin d'afficher un mini-lecteur intégré synchronisé et de contrôler la lecture (Play, Pause, Suivant, Précédent)."
                            FontSize="12"
                            Opacity="0.65"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        IsOn="{x:Bind Vm.IsBridgeEnabled, Mode=TwoWay}"
                        OnContent="Activé"
                        OffContent="Désactivé"
                        Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- CARD 4: SOUNDCLOUD ACCOUNT -->
            <Border
                Background="#18181E"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Border
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="#20FFFFFF"
                        Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE77B;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="Compte SoundCloud" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{x:Bind Vm.Username, Mode=OneWay}"
                            FontSize="13"
                            Foreground="{StaticResource SoundCloudOrangeBrush}"
                            FontWeight="Medium" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Content="Déconnexion"
                        Visibility="{x:Bind Vm.IsUserLoggedIn, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                        Command="{x:Bind Vm.LogoutCommand}" />
                </Grid>
            </Border>

            <!-- CARD 5: ABOUT & UPDATES SECTION -->
            <Border
                Background="#18181E"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <StackPanel Spacing="18">
                    <!-- App Banner & Current Version -->
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="10"
                            Background="#22FFFFFF"
                            Margin="0,0,16,0">
                            <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="SCwin" FontSize="18" FontWeight="Bold" />
                                <Border Background="#25FF5500" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind Vm.CurrentVersion, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SoundCloudOrangeBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="Client SoundCloud natif pour Windows 10 &amp; 11 — 100% WinUI 3, ultraléger et sans WebView2."
                                FontSize="12"
                                Opacity="0.65" />
                        </StackPanel>

                        <!-- Action: Open GitHub Releases -->
                        <Button
                            Grid.Column="2"
                            Background="#20FFFFFF"
                            BorderThickness="0"
                            Padding="12,6"
                            CornerRadius="6"
                            Command="{x:Bind Vm.OpenGitHubReleasesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                <TextBlock Text="Releases GitHub" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Update Channel Selector -->
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Canal de mise à jour" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Choisissez entre les mises à jour Edge (dernières fonctionnalités) ou Stable (versions vérifiées)." FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            SelectedValue="{x:Bind Vm.UpdateChannel, Mode=TwoWay}"
                            SelectedValuePath="Tag"
                            Width="180">
                            <ComboBoxItem Content="Edge (Rapide)" Tag="Edge" />
                            <ComboBoxItem Content="Stable (Recommandé)" Tag="Stable" />
                        </ComboBox>
                    </Grid>

                    <!-- Auto Check on Startup Toggle -->
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Rechercher les mises à jour au démarrage" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Vérifie silencieusement au lancement si une nouvelle version est disponible et vous propose de la télécharger." FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind Vm.AutoCheckUpdatesOnStartup, Mode=TwoWay}"
                            OnContent="Activé"
                            OffContent="Désactivé" />
                    </Grid>

                    <!-- Check for Updates Action & Status Bar -->
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button
                                Background="{StaticResource SoundCloudOrangeBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="16,8"
                                Command="{x:Bind Vm.CheckForUpdatesCommand}"
                                IsEnabled="{x:Bind Vm.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource InvertedBooleanVisibilityConverter}, FallbackValue=True}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE895;" FontSize="13" />
                                    <TextBlock Text="Vérifier les mises à jour" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind Vm.IsCheckingForUpdates, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>

                        <!-- Download Update Button (visible when new release is found) -->
                        <Button
                            Grid.Column="1"
                            Background="#10B981"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="14,8"
                            Visibility="{x:Bind Vm.HasUpdateAvailable, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}}"
                            Command="{x:Bind Vm.OpenLatestUpdateUrlCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Text="Télécharger la mise à jour" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Update Status InfoBar -->
                    <InfoBar
                        IsOpen="{x:Bind Vm.IsUpdateResultOpen, Mode=OneWay}"
                        Message="{x:Bind Vm.UpdateCheckResult, Mode=OneWay}"
                        Severity="{x:Bind Vm.HasUpdateAvailable, Mode=OneWay, Converter={StaticResource BooleanVisibilityConverter}, FallbackValue='Success'}"
                        IsClosable="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
