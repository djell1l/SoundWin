<Page
    x:Class="SoundWin.App.Views.StreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models"
    xmlns:controls="using:SoundWin.App.Controls">

    <ScrollViewer Padding="32,24,32,48">
        <StackPanel HorizontalAlignment="Stretch" Spacing="24">
            <!-- Header Banner -->
            <Grid Padding="24" CornerRadius="12" Background="#18181E" BorderBrush="#25FFFFFF" BorderThickness="1">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE753;" FontSize="20" Foreground="{StaticResource SoundCloudOrangeBrush}" />
                        <TextBlock Text="Flux d'Actualités (Stream)" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="Retrouvez les dernières publications et reposts des artistes et créateurs que vous suivez." FontSize="13" Opacity="0.7" />
                </StackPanel>
            </Grid>

            <!-- Loading Ring -->
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                Margin="0,30,0,0" />

            <!-- Posts List -->
            <ListView
                ItemsSource="{x:Bind ViewModel.Posts, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StreamPost">
                        <Border
                            Margin="0,0,0,16"
                            Padding="16"
                            Background="#141418"
                            BorderBrush="#15FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Spacing="12">
                                <!-- Post Author & Action Tag -->
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <PersonPicture
                                        ProfilePicture="{x:Bind User.HighResAvatarUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                        DisplayName="{x:Bind User.Username}"
                                        Width="28"
                                        Height="28" />
                                    <TextBlock Text="{x:Bind HeaderText}" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
                                </StackPanel>

                                <!-- Render Track item -->
                                <controls:TrackRowControl
                                    Track="{x:Bind Track}"
                                    Visibility="{x:Bind Track, Converter={StaticResource NullToVisibilityConverter}}" />

                                <!-- Render Playlist item -->
                                <Button
                                    Visibility="{x:Bind Playlist, Converter={StaticResource NullToVisibilityConverter}}"
                                    Background="#1E1E26"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnStreamPlaylistClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="6" Margin="0,0,14,0">
                                            <Image Source="{x:Bind Playlist.DisplayArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Playlist.Title}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{x:Bind Playlist.Author}" FontSize="12" Opacity="0.65" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Opacity="0.6" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
