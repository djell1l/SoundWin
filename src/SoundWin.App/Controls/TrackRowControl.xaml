<UserControl
    x:Class="SoundWin.App.Controls.TrackRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models">

    <Border
        x:Name="RootBorder"
        Padding="10,6"
        CornerRadius="8"
        Background="Transparent"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        Tapped="OnRowTapped">

        <!-- Context Flyout (Right Click Menu) -->
        <Border.ContextFlyout>
            <MenuFlyout Opening="OnContextFlyoutOpening">
                <MenuFlyoutItem Text="Lire maintenant" Click="OnPlayClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Lire ensuite" Click="OnPlayNextClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Ajouter à la file d'attente" Click="OnAddToQueueClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE90B;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Lancer la station radio" Click="OnStartRadioStationClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="LikeMenuItem" Text="Ajouter aux coups de cœur" Click="OnToggleLikeClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RepostMenuItem" Text="Reposter sur mon flux" Click="OnToggleRepostClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8EB;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="AddToPlaylistSubItem" Text="Ajouter à une playlist">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Commentaires &amp; Réactions..." Click="OnOpenCommentsDialogClicked">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Comment" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="FollowArtistMenuItem" Text="S'abonner à cet artiste" Click="OnFollowArtistFromMenuClicked">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="AddFriend" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Voir le profil de l'artiste" Click="OnOpenArtistProfileClicked">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copier le lien SoundCloud" Click="OnCopyLinkClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Border.ContextFlyout>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
            <!-- Cover Art + Play Overlay -->
            <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                <Border CornerRadius="6" Background="#1E1E26">
                    <Image
                        Source="{x:Bind Track.HighResArtworkUrl, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>
                <Button
                    x:Name="PlayOverlayButton"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="16"
                    Padding="0"
                    Background="#D9000000"
                    Opacity="0"
                    Click="OnPlayClicked">
                    <SymbolIcon Symbol="Play" Foreground="White" />
                </Button>
            </Grid>

            <!-- Title & Artist -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind Track.Title, Mode=OneWay}"
                    FontWeight="SemiBold"
                    FontSize="14"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
                <TextBlock
                    Text="{x:Bind Track.Artist, Mode=OneWay}"
                    FontSize="12"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </StackPanel>

            <!-- Duration -->
            <TextBlock
                Grid.Column="2"
                Text="{x:Bind Track.FormattedDuration, Mode=OneWay}"
                FontSize="12"
                Opacity="0.6"
                VerticalAlignment="Center"
                Margin="12,0" />

            <!-- Like Quick Button (Dynamically Synced) -->
            <Button
                x:Name="LikeActionBtn"
                Grid.Column="3"
                Background="Transparent"
                BorderThickness="0"
                Padding="6"
                VerticalAlignment="Center"
                Click="OnToggleLikeClicked"
                ToolTipService.ToolTip="Coup de cœur (Like)">
                <FontIcon
                    Glyph="{x:Bind Track.IsLiked, Mode=OneWay, Converter={StaticResource BooleanHeartConverter}}"
                    Foreground="{x:Bind Track.IsLiked, Mode=OneWay, Converter={StaticResource BooleanOrangeBrushConverter}}"
                    FontSize="14" />
            </Button>

            <!-- Repost Quick Button (Dynamically Synced) -->
            <Button
                x:Name="RepostActionBtn"
                Grid.Column="4"
                Background="Transparent"
                BorderThickness="0"
                Padding="6"
                VerticalAlignment="Center"
                Click="OnToggleRepostClicked"
                ToolTipService.ToolTip="Reposter">
                <FontIcon
                    Glyph="&#xE8EB;"
                    Foreground="{x:Bind Track.IsReposted, Mode=OneWay, Converter={StaticResource BooleanOrangeBrushConverter}}"
                    FontSize="13" />
            </Button>

            <!-- Context Menu Button (...) -->
            <Button
                x:Name="MoreOptionsBtn"
                Grid.Column="5"
                Background="Transparent"
                BorderThickness="0"
                Padding="6"
                VerticalAlignment="Center"
                Click="OnMoreOptionsClicked"
                ToolTipService.ToolTip="Plus d'actions">
                <FontIcon Glyph="&#xE712;" FontSize="13" />
            </Button>
        </Grid>
    </Border>
</UserControl>
