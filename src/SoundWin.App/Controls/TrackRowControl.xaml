<UserControl
    x:Class="SoundWin.App.Controls.TrackRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SoundWin.Core.Models">

    <Border
        x:Name="RootBorder"
        Padding="10,6"
        CornerRadius="8"
        Background="Transparent"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <!-- Cover Art + Play Overlay -->
            <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                <Border CornerRadius="6">
                    <Image
                        Source="{x:Bind Track.HighResArtworkUrl, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>
                <Button
                    x:Name="PlayOverlayButton"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="16"
                    Padding="0"
                    Background="#D9000000"
                    Opacity="0"
                    Click="OnPlayClicked">
                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" Margin="2,0,0,0" />
                </Button>
            </Grid>

            <!-- Title & Artist -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind Track.Title, Mode=OneWay}"
                    FontWeight="SemiBold"
                    FontSize="14"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
                <TextBlock
                    Text="{x:Bind Track.Artist, Mode=OneWay}"
                    FontSize="12"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </StackPanel>

            <!-- Duration -->
            <TextBlock
                Grid.Column="2"
                Text="{x:Bind Track.FormattedDuration, Mode=OneWay}"
                FontSize="12"
                Opacity="0.6"
                VerticalAlignment="Center"
                Margin="12,0" />

            <!-- Options / Play Next -->
            <Button
                Grid.Column="3"
                Background="Transparent"
                BorderThickness="0"
                Padding="6"
                VerticalAlignment="Center"
                Click="OnPlayClicked"
                ToolTipService.ToolTip="Lire maintenant">
                <FontIcon Glyph="&#xE768;" FontSize="13" />
            </Button>
        </Grid>
    </Border>
</UserControl>
